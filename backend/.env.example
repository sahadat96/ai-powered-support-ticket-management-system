NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://sahadat:your-password@localhost:5432/ai-powered-ticket-management
# At least 32 random characters. Never commit a real secret.
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-characters
FRONTEND_URL=http://localhost:3000
API_ORIGIN=http://localhost:4000
# Explicitly opt in to known local demo accounts before seeding.
SEED_DEMO=false
DEMO_PASSWORD=change-this-demo-password
# HTTP integration tests require a separately created/migrated database ending in -test or _test.
TEST_DATABASE_URL=postgresql://sahadat:your-password@localhost:5432/ai-powered-ticket-management-test
