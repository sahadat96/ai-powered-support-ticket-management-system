# Copy to .env. The API reads the root .env automatically.
NODE_ENV=development
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ai-powered-ticket-management?schema=public
# Replace with a random secret of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRES_IN_SECONDS=28800
# Server-side Next.js proxy target; never exposed to the browser.
API_URL=http://localhost:4000/api/v1
# Required only by db:seed; use a strong local demonstration password.
DEMO_PASSWORD=ChangeMe123!
